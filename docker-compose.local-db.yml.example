name: ai-mock-interview-dev

services:
  mysql:
    image: mysql:5.7
    container_name: ai-dev-mysql
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_general_ci
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?Set this variable in your local environment}
      MYSQL_DATABASE: interview_agent
      MYSQL_USER: zzh
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?Set this variable in your local environment}
      TZ: Asia/Shanghai
    ports:
      - "13306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ./interview_agent.sql:/docker-entrypoint-initdb.d/01_interview_agent.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$$MYSQL_ROOT_PASSWORD --silent"]
      interval: 5s
      timeout: 5s
      retries: 30
    restart: unless-stopped

  admin-server:
    environment:
      SPRING_DATASOURCE_DRIVER_CLASS_NAME: com.mysql.cj.jdbc.Driver
      SPRING_DATASOURCE_URL: "jdbc:mysql://mysql:3306/interview_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"
      SPRING_DATASOURCE_USERNAME: zzh
      SPRING_DATASOURCE_PASSWORD: ${MYSQL_PASSWORD:?Set this variable in your local environment}
    depends_on:
      mysql:
        condition: service_healthy

volumes:
  mysql_data:
