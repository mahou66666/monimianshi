# Mock mode:
# true  -> use local mocks
# false -> use real backend API
VITE_USE_MOCK=true

# Module-level mock overrides.
# Leave empty to inherit VITE_USE_MOCK.
# Example for first-wave real API rollout:
# VITE_USE_MOCK_ACCOUNT=false
# VITE_USE_MOCK_USER=false
VITE_USE_MOCK_ACCOUNT=
VITE_USE_MOCK_USER=
VITE_USE_MOCK_RESUME=
VITE_USE_MOCK_JD=
VITE_USE_MOCK_INTERVIEW=
VITE_USE_MOCK_HOME=

# Leave empty when your api files already start with `/api/...`.
# Example:
# VITE_API_BASE_URL=
#
# Only set this when you want to point to a full backend origin, for example:
# VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_API_BASE_URL=

# Optional dev proxy target.
# When set, Vite will forward /api requests to this backend in dev mode.
# Example: http://127.0.0.1:8080
VITE_PROXY_TARGET=

# Interview websocket (optional, enabled by default when available).
# Example: ws://127.0.0.1:8080/interview/ws
VITE_INTERVIEW_WS_URL=
# Example: 8010
VITE_INTERVIEW_WS_PORT=
# Set true to force HTTP only.
VITE_DISABLE_INTERVIEW_WS=false

# Max interview voice duration in seconds before frontend truncates audio.
# Example: 600
VITE_ASR_MAX_DURATION_SECONDS=
